# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-in-production-use-openssl-rand-base64-32

# Database (Production)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=polls_db
DB_USER=polls_user
DB_PASSWORD=secure_password_here
DB_HOST=localhost
DB_PORT=5432

# Email
EMAIL_HOST=smtp.mailprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@mailprovider.com
EMAIL_HOST_PASSWORD=your_email_password

# Security (Production)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
SECURE_SSL_REDIRECT=True

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_PORT=8000
